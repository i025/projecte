{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "regions"
  ],
  "properties": {
    "regions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "location",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[1-5]$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    }
  }
}
